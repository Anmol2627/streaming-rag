# Streaming Live RAG — Environment Configuration
# Copy this file to .env and fill in your values

# Groq API Key (free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# LLM Model (Groq-hosted)
LLM_MODEL=llama-3.1-8b-instant

# Embedding Model (local, downloaded automatically)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Corpus Path (relative to project root)
CORPUS_PATH=streaming-rag-dev-demo-corpus/corpus/documents

# Server
HOST=0.0.0.0
PORT=8000

# Controller Thresholds
CONTROLLER_DRIFT_THRESHOLD=0.15
CONTROLLER_DEBOUNCE_MS=300
CONTROLLER_MAX_WAIT_CHUNKS=10

# Retrieval
RETRIEVAL_TOP_K=20
RETRIEVAL_FUSION_K=60
RETRIEVAL_MIN_RELEVANCE=0.25
MAX_SUB_QUERIES=5

# Synthesis
CITATION_ENTAILMENT_THRESHOLD=0.3
