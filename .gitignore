# .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment — never commit real keys
.env

# FAISS / embedding index cache (rebuilt on first run)
.index_cache/

# Per-session telemetry logs (these grow unboundedly)
telemetry_logs/

# Benchmark output — generated by scripts/run_benchmark_eval.py
benchmark_results.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# Internal — not for evaluators
docs/DEMO_GUIDE.md

# Logs
*.log
